    {
      "id": "bkHC",
      "code_hash": "dbd692233d44d5585fb84f3c0abfe058",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"1\">1. \ud14d\uc2a4\ud2b8 \uc815\uc81c</h2>\n<span class=\"paragraph\">\uc6d0\ubcf8 \ud14d\uc2a4\ud2b8\uc5d0\ub294 \uac15\uc758 \ub0b4\uc6a9\uacfc \ubb34\uad00\ud55c \ubb38\uc7a5\uc774 \ub9ce\uc544 \uadf8\ub300\ub85c \uc4f0\uba74 \ubaa8\ub4e0 \uac15\uc758\uac00 \ube44\uc2b7\ud574 \ubcf4\uc785\ub2c8\ub2e4.</span>\n<ul>\n<li><strong>\ud15c\ud50c\ub9bf \ucee4\ub9ac\ud058\ub7fc \uc81c\uac70:</strong> \u300c\u2026 \ud575\uc2ec \ud504\ub85c\uc138\uc2a4 \uc2e4\uc2b5 // \uc2e4\ubb34 \uc11c\uc2dd \uc791\uc131 \u2026\u300d \ud615\ud0dc\ub85c \uc790\ub3d9 \uc0dd\uc131\ub41c \ucee4\ub9ac\ud058\ub7fc\uc740 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.</li>\n<li><strong>\uae30\uad00 \ud64d\ubcf4 \ubb38\uad6c \uc81c\uac70:</strong> \uc18c\uac1c\uae00\uc744 \ubb38\uc7a5 \ub2e8\uc704\ub85c \ucabc\uac20 \ub4a4, \uc11c\ub85c \ub2e4\ub978 \uac15\uc758 3\uac1c \uc774\uc0c1\uc5d0 \ub611\uac19\uc774 \ub4f1\uc7a5\ud558\ub294 \ubb38\uc7a5(\ud6c8\ub828\uae30\uad00 \uc18c\uac1c, \ucde8\uc5c5\uc9c0\uc6d0 \uc548\ub0b4 \ub4f1)\uc744 \uc9c0\uc6c1\ub2c8\ub2e4.</li>\n<li><strong>\ud68c\ucc28 \ud45c\uae30 \uc81c\uac70:</strong> <code>(\uc5d0\ub4c0\ud4e8\uc5b4 2\ud68c\ucc28)</code> \uac19\uc740 \uaf2c\ub9ac\ud45c\ub97c \ub5bc\uc5b4 \uac19\uc740 \uac15\uc758\ub97c \ud558\ub098\uc758 \uc81c\ubaa9\uc73c\ub85c \ubd05\ub2c8\ub2e4.</li>\n<li><strong>\ubd84\uc11d \ubb38\uc11c \uad6c\uc131:</strong> \uc81c\ubaa9(\uac00\uc911\uce58 \u00d72) + \uc815\uc81c\ub41c \uc18c\uac1c\uae00 + \uc2e4\uc81c \ucee4\ub9ac\ud058\ub7fc(NCS \ub2a5\ub825\ub2e8\uc704\uba85)</li>\n<li><code>target_audience</code>\ub294 220\uac1c\uac00 \uac19\uc740 \ubb38\uc7a5\uc774\uace0, <code>learning_objectives</code>\ub294 220\uac1c\uac00 \uc18c\uac1c\uae00\uacfc \ub611\uac19\uc544\uc11c \uc81c\uc678\ud569\ub2c8\ub2e4.</li>\n</ul></span>"
          }
        }
      ],
      "console": []
    },
